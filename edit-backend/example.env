DATABASE_URL=mysql://userDocker:passDocker@localhost:3306/nouse
REDIS_HOST=localhost
# Optional login for Valkey/Redis. Leave the username blank to use the default user.
REDIS_USERNAME=
REDIS_PASSWORD=
# Optional: set to true to use TLS for every Valkey/Redis connection, including the Sentinels.
REDIS_TLS=
# Optional: database number and a prefix for every key, for a shared Valkey/Redis server.
REDIS_DB=
REDIS_KEY_PREFIX=
# Optional: comma-separated host:port list. When set, connects through Sentinel and ignores REDIS_HOST/REDIS_PORT.
REDIS_SENTINELS=
REDIS_SENTINEL_MASTER=mymaster
# Login for the Sentinels themselves, if they require one. Not inherited from REDIS_USERNAME/REDIS_PASSWORD.
REDIS_SENTINEL_USERNAME=
REDIS_SENTINEL_PASSWORD=
MYSQL_HOSTNAME=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=nouse
MYSQL_USERNAME=userDocker
MYSQL_PASSWORD=passDocker
ARCHIVEFILESTOREURL=https://bbcdn.nouse.co.uk/file/nouseOldImageLibrary/archive/public
FILESTOREURL=https://bbcdn.nouse.co.uk/file
FRONTEND_URL=http://localhost:4321/
GRAFANA_URL=http://localhost:3001/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXTAUTH_URL=http://localhost:3000
# This can be generated by openssl rand -base64 32
NEXTAUTH_SECRET=
# This can be generated by openssl rand -base64 32
DRAFT_VIEW_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_ENDPOINT_URL=

AWS_CDN=
AWS_BUCKET=

# This can be generated by openssl rand -base64 32
GRAFANA_CLIENT_SECRET=

# Article side effects (same values as the PHP admin's config)
# IFTTT webhook key for the Facebook/Twitter posting applets
bCMS__IFTTT=
# Cloudflare account email and global API key, used to purge the readers site cache
bCMS__CLOUDFLARE_EMAIL=
bCMS__CLOUDFLARE_SECRET=
# SMTP server for the York SU Media Charter notification (port 587, STARTTLS)
EMAIL_HOST=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

NODE_ENV=development
# Shared secret for the internal cron endpoint (/api/internal/cron/articles). Must be set or the endpoint rejects every request.
CRON_SECRET=
# Base URL the cron script uses to reach edit-backend (same container).
INTERNAL_APP_URL=http://localhost:3000
